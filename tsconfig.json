{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@common/*": ["common/*"],
			"@server/*": ["server/src/*"]
		},
		"target": "es2020",
		"module": "commonjs",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["common", "server/src", "tests"]
}
