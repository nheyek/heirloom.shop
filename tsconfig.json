{
	"compilerOptions": {
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@common/*": ["./common/*"],
			"@server/*": ["./server/src/*"],
			"@client/*": ["./client/src/*"]
		},
		"target": "es2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["jest", "node"]
	},
	"include": ["common", "server/src", "tests"]
}
