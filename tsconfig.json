{
	"compilerOptions": {
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@heirloom/common/*": ["./common/*.js"],
			"@server/*": ["./server/src/*"],
			"@client/*": ["./client/src/*"]
		},
		"target": "ES2022",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["jest", "node"]
	},
	"include": ["common", "server/src", "tests"]
}
